{
    "name": "switon/view",
    "description": "HTML views with request-scoped state, controller template resolution, and an HTTP response bridge for Switon Framework",
    "type": "library",
    "keywords": [
        "switon",
        "view",
        "templates",
        "rendering"
    ],
    "homepage": "https://github.com/switon-php/view",
    "license": "MIT",
    "authors": [
        {
            "name": "switon",
            "email": "admin@switon.dev"
        }
    ],
    "support": {
        "source": "https://github.com/switon-php/view",
        "issues": "https://github.com/switon-php/view/issues",
        "docs": "https://github.com/switon-php/view/blob/main/docs/README.md"
    },
    "require": {
        "php": ">=8.3",
        "switon/core": "^1.0",
        "switon/event": "^1.0",
        "switon/http": "^1.0",
        "switon/renderer": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "switon/testing": "^1.0",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "switon/composer-extra": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Switon\\Viewing\\": "src/"
        },
        "files": [
            "helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Switon\\Viewing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test:unit": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=unit --display-deprecations --display-phpunit-notices",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
    "extra": {
        "switon": {
            "providers": [
                "Switon\\Viewing\\ServiceProvider"
            ],
            "listeners": [
                "Switon\\Viewing\\ViewRenderer"
            ]
        },
        "branch-alias": {
            "dev-dev": "1.0.x-dev"
        }
    }
}
